# Copy to .env and adjust as needed. All values shown are the defaults.

# Reference "today" used for vehicle-age calculation and market pricing
VELOX_CURRENT_YEAR=2026

# The year the raw CarDekho listing prices actually reflect
VELOX_DATA_REFERENCE_YEAR=2021

# Assumed annual used-car market price appreciation (India), used to scale
# VELOX_DATA_REFERENCE_YEAR prices up to VELOX_CURRENT_YEAR-equivalent levels
VELOX_ANNUAL_APPRECIATION=0.08

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
VELOX_LOG_LEVEL=INFO

# Where trained model artifacts are read from / written to
VELOX_MODEL_DIR=.
VELOX_DATA_DIR=./data

# FastAPI service bind address/port
VELOX_API_HOST=0.0.0.0
VELOX_API_PORT=8000
